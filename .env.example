# Copie este arquivo para .env e ajuste os valores conforme necessário.
# Nunca commite o .env real.

# --- Postgres ---
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina_dev_password
POSTGRES_DB=oficina_saas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://oficina:oficina_dev_password@localhost:5432/oficina_saas?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Backend (NestJS) ---
BACKEND_PORT=3001
# CORS: lista de origens permitidas, separadas por vírgula
CORS_ORIGIN=http://localhost:3000
# JWT — gere um valor forte em produção (ex: openssl rand -base64 48)
JWT_SECRET=dev_only_change_me
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
INVITE_TOKEN_TTL_SECONDS=604800
# Rate limiting básico (signup/login/accept-invite)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# URL do frontend — usada para montar o link de convite (sem envio de e-mail
# real nesta feature; ver spec)
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads

# --- Frontend (Next.js) ---
# PORT é a variável nativa que o Next.js lê (next dev / next start) — não
# use FRONTEND_PORT aqui, pois "next dev -p ${FRONTEND_PORT:-3000}" só
# funciona em shells POSIX e quebra no cmd.exe/PowerShell usado pelo pnpm
# no Windows.
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- NGINX ---
NGINX_PORT=8080

# Identificação pública do fornecedor (definir antes de publicar e reconstruir frontend).
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_COMPANY_DOCUMENT=
NEXT_PUBLIC_LEGAL_COMPANY_ADDRESS=
NEXT_PUBLIC_PRIVACY_EMAIL=
