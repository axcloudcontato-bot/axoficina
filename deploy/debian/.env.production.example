# Endereço IP ou nome DNS do servidor Debian, sem http://.
SERVER_HOST=192.168.0.250
FRONTEND_HOST_PORT=3005
BACKEND_HOST_PORT=3006
PUBLIC_FRONTEND_URL=http://192.168.0.250:3005
PUBLIC_BACKEND_URL=http://192.168.0.250:3006

POSTGRES_USER=axcloud
POSTGRES_PASSWORD=gere_um_segredo_forte
POSTGRES_DB=axcloudmecanica
# Use percent-encoding se a senha contiver caracteres reservados.
DATABASE_URL=postgresql://axcloud:senha_codificada@postgres:5432/axcloudmecanica?schema=public

JWT_SECRET=gere_outro_segredo_forte
SETTINGS_ENCRYPTION_KEY=gere_um_terceiro_segredo_forte
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
INVITE_TOKEN_TTL_SECONDS=604800
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Opcional: somente para iniciar o perfil HTTPS/Caddy.
DOMAIN=oficina.seudominio.com.br
ACME_EMAIL=contato@seudominio.com.br
