# Endereço IP ou nome DNS do servidor Debian, sem http://.
SERVER_HOST=192.168.0.250
FRONTEND_HOST_PORT=3005
BACKEND_HOST_PORT=3006
# Domínio público (HTTPS via Cloudflare Tunnel + Caddy). Frontend e API
# compartilham a mesma origem: o Caddy envia /api/* ao backend.
PUBLIC_FRONTEND_URL=https://ofix.axcloud.com.br
PUBLIC_BACKEND_URL=https://ofix.axcloud.com.br
# Acesso direto na rede local (sem domínio), se preferir:
# PUBLIC_FRONTEND_URL=http://192.168.0.250:3005
# PUBLIC_BACKEND_URL=http://192.168.0.250:3006
# Para receber callbacks do WA-AKG, PUBLIC_BACKEND_URL deve ser HTTPS público.
WA_AKG_ALLOWED_HOSTS=chat.axcloud.com.br
# Opcional: usar o cache público do Google se o acesso ao Docker Hub falhar.
# DOCKER_LIBRARY_REGISTRY=mirror.gcr.io

POSTGRES_USER=axcloud
POSTGRES_PASSWORD=gere_um_segredo_forte
POSTGRES_DB=axcloudmecanica
# Use percent-encoding se a senha contiver caracteres reservados.
DATABASE_URL=postgresql://axcloud:senha_codificada@postgres:5432/axcloudmecanica?schema=public

JWT_SECRET=gere_outro_segredo_forte
SETTINGS_ENCRYPTION_KEY=gere_um_terceiro_segredo_forte
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
INVITE_TOKEN_TTL_SECONDS=604800
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# IDs dos usuários autorizados a administrar assinaturas de todas as oficinas.
# Separe múltiplos UUIDs por vírgula; ADMIN da oficina não concede este acesso.
SAAS_ADMIN_USER_IDS=

# Opcional: descomente para ativar o Caddy (profiles: [tunnel]), que
# escuta em 127.0.0.1:3010 pronto para um Cloudflare Tunnel (ou outro
# reverse proxy local) apontar pra lá. Sem isso, backend/frontend só
# ficam acessíveis pelas portas acima.
# Necessário para o domínio ofix.axcloud.com.br: no Cloudflare Tunnel, aponte
# o hostname para http://localhost:3010.
COMPOSE_PROFILES=tunnel
