[Unit]
Description=Backup do Ofix fora do servidor (banco e fotos, criptografado)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/env bash /opt/oficina-mecanica/deploy/debian/backup-offsite.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
