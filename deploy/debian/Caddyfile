# HTTP puro: o Cloudflare Tunnel termina o HTTPS público na borda e entrega
# aqui já descriptografado — não há certificado pra emitir neste Caddy.
:80 {
	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
}
