# HTTP puro: o Cloudflare Tunnel termina o HTTPS público na borda e entrega
# aqui já descriptografado — não há certificado pra emitir neste Caddy.
:80 {
	encode zstd gzip

	# www → domínio principal. Requer o hostname www no Cloudflare Tunnel e um
	# CNAME www apontando para o mesmo túnel.
	@www host www.ofix.axcloud.com.br
	redir @www https://ofix.axcloud.com.br{uri} permanent

	@api path /api/*
	handle @api {
		reverse_proxy backend:3001
	}

	# Public health check for the uptime monitor: only status and which dependency is down, no data.
	@health path /health
	handle @health {
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		# The public site is HTTPS only (Cloudflare); browsers stop trying plain HTTP for a year.
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		# No scripts restricted here (Next.js inline scripts); this blocks plugins, <base> hijacking, framing and
		# forms posting elsewhere.
		Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
		# Full policy in report-only mode: nothing is blocked, the browser reports what it WOULD block to the backend log
		# (docker compose logs backend | grep CSP). After a few days without own-origin reports, switch the name to
		# Content-Security-Policy to enforce it (docs/seguranca.md). 'unsafe-inline' stays for Next.js inline scripts and
		# styles; viacep.com.br is the CEP lookup and ingest.de.sentry.io the optional error monitoring.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self' https://accounts.google.com https://viacep.com.br https://*.ingest.de.sentry.io; media-src 'self' blob:; frame-src https://accounts.google.com; worker-src 'self' blob:; manifest-src 'self'; report-uri /api/v1/csp-report"
	}
}
