# Variáveis específicas do backend — o .env.example da raiz cobre o que é
# compartilhado com outros serviços (DATABASE_URL, REDIS_URL, etc.)
BACKEND_PORT=3001
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=dev_only_change_me
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
INVITE_TOKEN_TTL_SECONDS=604800
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads

# IDs dos usuários autorizados a administrar todas as assinaturas, separados por vírgula.
# O papel ADMIN de uma oficina não concede acesso global.
SAAS_ADMIN_USER_IDS=

# Emissão de notas fiscais (Focus NFe, docs/nota-fiscal.md). Vazio: só registro manual de notas na OS.
# Em desenvolvimento, use o token de homologação da conta. As URLs abaixo são os padrões.
FOCUS_NFE_TOKEN=
# FOCUS_NFE_URL=https://api.focusnfe.com.br
# FOCUS_NFE_HOMOLOGATION_URL=https://homologacao.focusnfe.com.br
