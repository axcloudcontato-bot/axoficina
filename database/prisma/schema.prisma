  @@index([tenantId])
  @@index([serviceOrderId])
  @@index([tenantId, receivedAt])
  @@map("service_order_receipts")
}

model ServiceOrderInstallment {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
