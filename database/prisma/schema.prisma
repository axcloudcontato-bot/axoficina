model FinancialCashBaseline {
  tenantId    String   @id @map("tenant_id") @db.Uuid
  amountCents Int      @map("amount_cents")
  asOf        DateTime @map("as_of") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("financial_cash_baselines")
}

model Supplier {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String
  document     String?
  contactName  String?   @map("contact_name")
  phone        String?
  email        String?
  paymentTerms String?   @map("payment_terms")
  notes        String?
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, name])
  @@map("suppliers")
}

// Public access is limited to a random, hashed, expiring token. Authenticated
// access is tenant-scoped. Message stores the exact context sent to the client.
model CustomerMessage {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  serviceOrderId String    @map("service_order_id") @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  channel        String
  purpose        String    @default("CUSTOM")
  quoteSnapshot  Json?     @map("quote_snapshot")
  deliveryMode   String    @default("LINK") @map("delivery_mode")
  sentAt         DateTime? @map("sent_at") @db.Timestamptz
  whatsappSessionId String? @map("whatsapp_session_id")
  whatsappRecipient String? @map("whatsapp_recipient")
  providerMessageId String? @map("provider_message_id")
  question       String
  options        String[]
  message        String
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  selectedOption Int?      @map("selected_option")
  answeredAt     DateTime? @map("answered_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, serviceOrderId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, answeredAt, id])
  @@map("customer_messages")
}

// A resposta é a própria notificação; esta tabela guarda apenas a leitura
// por usuário. Repetições do callback não criam notificações duplicadas.
model CustomerReplyRead {
  tenantId          String   @map("tenant_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  customerMessageId String   @map("customer_message_id") @db.Uuid
  readAt            DateTime @default(now()) @map("read_at") @db.Timestamptz

  @@id([tenantId, userId, customerMessageId])
  @@map("customer_reply_reads")
}

model Appointment {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  customerId         String    @map("customer_id") @db.Uuid
  vehicleId          String    @map("vehicle_id") @db.Uuid
  technicianId       String?   @map("technician_id") @db.Uuid
  serviceOrderId     String?   @map("service_order_id") @db.Uuid
  startsAt           DateTime  @map("starts_at") @db.Timestamptz
  endsAt             DateTime  @map("ends_at") @db.Timestamptz
  serviceDescription String    @map("service_description")
  notes              String?
  status             String    @default("SCHEDULED")
  createdBy          String    @map("created_by") @db.Uuid
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz
  reminderSentAt     DateTime? @map("reminder_sent_at") @db.Timestamptz
  confirmationSentAt DateTime? @map("confirmation_sent_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, startsAt, endsAt])
  @@index([tenantId, technicianId, startsAt, endsAt])
  @@index([customerId])
  @@index([vehicleId])
  @@map("appointments")
}
