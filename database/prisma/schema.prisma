// Configuração base do Prisma para o Oficina SaaS.
// Feature 2 (IAM) adiciona os primeiros models de domínio: Tenant, User,
// RefreshToken, Role, Permission, RolePermission, AuditLog.
// Ver docs/superpowers/specs/2026-07-14-arquitetura-mvp-design.md seção 5.
//
// Convenções: snake_case no banco (via @map/@@map), TEXT (String sem
// @db.VarChar), UUID via uuid_generate_v4(), TIMESTAMPTZ em UTC, soft delete
// (deleted_at), sem foreign keys físicas — integridade validada na camada de
// aplicação (Manager).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// document (Tenant) e email (User) NÃO usam @unique aqui de propósito:
// unicidade real é um índice único PARCIAL (WHERE deleted_at IS NULL),
// escrito à mão na migration, para não bloquear reuso depois de um soft
// delete. Ver migrations/*_iam_models/migration.sql.
//
// email é único GLOBALMENTE (não por tenant): o contrato de POST /auth/login
// (spec) recebe só { email, password }, sem identificador de tenant — se o
// mesmo e-mail pudesse existir em tenants diferentes, o login seria
// ambíguo. Uma pessoa que trabalha em duas oficinas precisa de e-mails
// diferentes nesta versão do produto.
model CustomerCareSettings {
  tenantId     String   @id @map("tenant_id") @db.Uuid
  enabled      Boolean  @default(false)
  channel      String   @default("WHATSAPP")
  timeZone     String   @default("America/Sao_Paulo") @map("time_zone")
  sendHour     Int      @default(9) @map("send_hour")
  weekdaysOnly Boolean  @default(true) @map("weekdays_only")
  minGapDays   Int      @default(7) @map("min_gap_days")
  dailyLimit   Int      @default(50) @map("daily_limit")
  campaigns    Json
  updatedBy    String?  @map("updated_by") @db.Uuid
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  @@map("customer_care_settings")
}

model CustomerCarePlan {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  vehicleId      String   @map("vehicle_id") @db.Uuid
  serviceKey     String   @map("service_key")
  completedAt    DateTime @map("completed_at") @db.Timestamptz
  mileage        Int?
  intervalMonths Int?     @map("interval_months")
  intervalKm     Int?     @map("interval_km")
  sourceOrderId  String?  @map("source_order_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  @@unique([tenantId, vehicleId, serviceKey], map: "care_plans_tenant_vehicle_service_key")
  @@index([tenantId, customerId], map: "care_plans_tenant_customer_idx")
  @@map("customer_care_plans")
}

// One attempt by the team to reach, by hand, a customer about a care plan.
model CustomerCareContact {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  outcome   String
  note      String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, planId, createdAt])
  @@map("customer_care_contacts")
}

model CustomerCareDelivery {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  customerName    String    @map("customer_name")
  campaignKeys    String[]  @map("campaign_keys")
  eventKeys       String[]  @map("event_keys")
  events          Json
  dedupeKey       String    @map("dedupe_key")
  channel         String
  recipient       String
  message         String
  subject         String
  status          String    @default("PENDING")
  reason          String?
  unsubscribeHash String    @unique @map("unsubscribe_hash")
  unsubscribeToken String   @map("unsubscribe_token")
  scheduledAt     DateTime  @map("scheduled_at") @db.Timestamptz
  attemptedAt     DateTime? @map("attempted_at") @db.Timestamptz
  sentAt          DateTime? @map("sent_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  @@unique([tenantId, dedupeKey], map: "care_deliveries_tenant_dedupe_key")
  @@index([tenantId, customerId, createdAt], map: "care_deliveries_tenant_customer_idx")
  @@index([status, scheduledAt], map: "care_deliveries_status_scheduled_idx")
  @@index([eventKeys], type: Gin, map: "care_deliveries_events_idx")
  @@map("customer_care_deliveries")
}

model Tenant {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                String
  legalName           String?   @map("legal_name")
  document            String
  stateRegistration   String?   @map("state_registration")
  phone               String?
  whatsapp            String?
  email               String?
  website             String?
  addressStreet       String?   @map("address_street")
  addressNumber       String?   @map("address_number")
  addressComplement   String?   @map("address_complement")
  addressDistrict     String?   @map("address_district")
  addressCity         String?   @map("address_city")
  addressState        String?   @map("address_state")
  addressPostalCode   String?   @map("address_postal_code")
  logoDataUrl         String?   @map("logo_data_url")
  documentFooter      String?   @map("document_footer")
  smtpHost            String?   @map("smtp_host")
  smtpPort            Int       @default(587) @map("smtp_port")
  smtpSecure          Boolean   @default(false) @map("smtp_secure")
  smtpUsername        String?   @map("smtp_username")
  smtpPassword        String?   @map("smtp_password")
  smtpFromName        String?   @map("smtp_from_name")
  smtpFromEmail       String?   @map("smtp_from_email")
  smtpReplyTo         String?   @map("smtp_reply_to")
  smtpEnabled         Boolean   @default(false) @map("smtp_enabled")
  waAkgBaseUrl         String?   @map("wa_akg_base_url")
  waAkgSessionId       String?   @map("wa_akg_session_id")
  waAkgApiKey          String?   @map("wa_akg_api_key")
  waAkgWebhookSecret   String?   @map("wa_akg_webhook_secret")
  waAkgEnabled         Boolean   @default(false) @map("wa_akg_enabled")
  photoRequireEntry    Boolean   @default(true) @map("photo_require_entry")
  photoRequireExit     Boolean   @default(true) @map("photo_require_exit")
  photoRequireItems    Boolean   @default(true) @map("photo_require_items")
  agendaOpenHour       Int       @default(8) @map("agenda_open_hour")
  agendaCloseHour      Int       @default(18) @map("agenda_close_hour")
  agendaWorkDays       Int[]     @default([1, 2, 3, 4, 5, 6]) @map("agenda_work_days")
  agendaBays           Int?      @map("agenda_bays")
  appointmentRemindersEnabled Boolean @default(false) @map("appointment_reminders_enabled")
  laborRateCents       Int?      @map("labor_rate_cents")
  maintenanceAlertMonths Int @default(6) @map("maintenance_alert_months")
  plan                String    @default("free")
  subscriptionStatus      String    @default("unconfigured") @map("subscription_status")
  subscriptionAmountCents Int       @default(0) @map("subscription_amount_cents")
  subscriptionCycle       String    @default("monthly") @map("subscription_cycle")
  subscriptionDueAt       DateTime? @map("subscription_due_at") @db.Timestamptz
  subscriptionNotes       String?   @map("subscription_notes")
  status              String    @default("active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz

  @@map("tenants")
}

model User {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  email           String
  passwordHash    String?   @map("password_hash")
  name            String
  roleId          String    @map("role_id") @db.Uuid
  status          String    @default("invited")
  inviteTokenHash String?   @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at") @db.Timestamptz
  mfaEnabled      Boolean   @default(false) @map("mfa_enabled")
  mfaSecret       String?   @map("mfa_secret")
  legalVersion    String?   @map("legal_version")
  legalAcceptedAt DateTime? @map("legal_accepted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// Protocolos: não armazenar senhas, documentos completos ou anexos.
model PrivacyRequest {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  customerId     String?   @map("customer_id") @db.Uuid
  type           String
  status         String    @default("OPEN")
  details        String?
  response       String?
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  dueAt          DateTime  @map("due_at") @db.Timestamptz
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  retentionUntil DateTime? @map("retention_until") @db.Timestamptz

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, status, dueAt])
  @@map("privacy_requests")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  userAgent String?   @map("user_agent")
  ip        String?   @db.Inet
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  name        String
  description String?
  baseRole    String    @default("ADMIN") @map("base_role")
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key         String @unique
  description String

  @@map("permissions")
}

model RolePermission {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model AuditLog {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id") @db.Uuid
  metadata  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("audit_logs")
}

// Feature 3 (Clientes). document NÃO usa @unique aqui de propósito: a
// unicidade real é um índice único parcial COMPOSTO (tenant_id, document)
// WHERE deleted_at IS NULL, escrito à mão na migration — diferente do
// índice single-column de tenants.document, porque aqui o documento é
// único POR TENANT, não globalmente (a mesma pessoa pode ser cliente de
// oficinas diferentes). Ver spec clientes-crud-pf-pj.md.
model Customer {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  type      String
  document  String
  name      String
  email     String?
  phone     String
  address   Json?
  notes     String?

  // Feature 6 (Cadastro de Cliente Expandido). Todas opcionais, sem
  // validação cruzada com `type` — ver spec cadastro-cliente-expandido.md.
  rg                        String?
  stateRegistration         String?   @map("state_registration")
  secondaryContactName      String?   @map("secondary_contact_name")
  secondaryContactPhone     String?   @map("secondary_contact_phone")
  secondaryContactRelation  String?   @map("secondary_contact_relation")
  preferredContactChannel   String?   @map("preferred_contact_channel")
  preferredContactTime      String?   @map("preferred_contact_time")
  notifyServiceOrderUpdates Boolean   @default(false) @map("notify_service_order_updates")
  birthDate                 DateTime? @map("birth_date") @db.Date
  careMessagesEnabled       Boolean   @default(false) @map("care_messages_enabled")
  careConsentAt             DateTime? @map("care_consent_at") @db.Timestamptz
  careConsentSource         String?   @map("care_consent_source")
  careConsentBy             String?   @map("care_consent_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId])
  @@map("customers")
}

// Feature 4 (Veículos). Mesmo padrão de unicidade por tenant do Customer.
// customerId é uma FK lógica pra customers (validada no VehicleManager via
// CustomerRepository.byId, nunca uma constraint física — ver SCHEMA.md).
model Vehicle {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  brand      String
  model      String
  year       Int?
  engine     String?
  fuelType   String?   @map("fuel_type")
  plate      String
  chassis    String?
  mileage    Int?
  color      String?
  photos     String[]  @default([])
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId])
  @@index([customerId])
  @@map("vehicles")
}

// Feature 5 (Ordem de Serviço). customerId é derivado de vehicle.customerId
// no momento da criação (VehicleManager/ServiceOrderManager), nunca aceito
// diretamente da API — ver spec ordem-de-servico.md. vehicleId e
// technicianId são FKs lógicas (vehicles, users), validadas no
// ServiceOrderManager, nunca uma constraint física.
model ServiceOrder {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  orderNumber   Int       @map("order_number")
  customerId    String    @map("customer_id") @db.Uuid
  vehicleId     String    @map("vehicle_id") @db.Uuid
  status        String
  checklist     Json?
  diagnosis     String?
  entryMileage  Int?      @map("entry_mileage")
  exitMileage   Int?      @map("exit_mileage")
  discountCents Int       @default(0) @map("discount_cents")
  warrantyDays  Int?      @map("warranty_days")
  customerComplaint String? @map("customer_complaint")
  receptionNotes String?  @map("reception_notes")
  recommendedService String? @map("recommended_service")
  expectedDeliveryAt DateTime? @map("expected_delivery_at") @db.Timestamptz
  paymentMethod String? @map("payment_method")
  paymentInstallments Int? @map("payment_installments")
  paymentAnticipated Boolean @default(false) @map("payment_anticipated")
  paymentFirstDueAt DateTime? @map("payment_first_due_at") @db.Timestamptz
  technicianId  String?   @map("technician_id") @db.Uuid
  openedAt      DateTime  @map("opened_at") @db.Timestamptz
  closedAt      DateTime? @map("closed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId])
  @@unique([tenantId, orderNumber])
  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([technicianId])
  @@map("service_orders")
}

// Sem tenantId de propósito: só é lida/escrita por serviceOrderId, que já
// passou por um ServiceOrderRepository.byId() tenant-scoped antes de chegar
// aqui — ver Gotcha no plano ordem-de-servico.md. NÃO adicionar
// 'ServiceOrderStatusHistory' a TENANT_SCOPED_MODELS (a extensão Prisma
// quebraria tentando injetar tenant_id numa tabela sem essa coluna).
model ServiceOrderStatusHistory {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  serviceOrderId String   @map("service_order_id") @db.Uuid
  fromStatus     String?  @map("from_status")
  toStatus       String   @map("to_status")
  changedBy      String   @map("changed_by") @db.Uuid
  changedAt      DateTime @map("changed_at") @db.Timestamptz

  @@index([serviceOrderId])
  @@map("service_order_status_history")
}

model ServiceOrderStatusNotification {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  serviceOrderId String    @map("service_order_id") @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  historyId      String    @map("history_id") @db.Uuid
  kind           String    @default("STATUS")
  customerMessageId String? @map("customer_message_id") @db.Uuid
  responseToken  String?   @map("response_token")
  fromStatus     String?   @map("from_status")
  toStatus       String    @map("to_status")
  recipient      String
  message        String
  status         String    @default("PENDING")
  failureReason  String?   @map("failure_reason")
  attempts       Int       @default(0)
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz
  attemptedAt    DateTime? @map("attempted_at") @db.Timestamptz
  sentAt         DateTime? @map("sent_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([historyId, kind], map: "service_order_notices_history_kind_key")
  @@index([tenantId, serviceOrderId, createdAt], map: "service_order_status_notifications_tenant_id_service_order_id_c")
  @@index([status, createdAt, id])
  @@index([serviceOrderId, status, createdAt, id], map: "service_order_status_notifications_service_order_id_status_crea")
  @@map("service_order_status_notifications")
}

// Feature: Itens e Preço da OS. Sem tenantId de propósito, mesmo padrão de
// ServiceOrderStatusHistory acima — só é lida/escrita por serviceOrderId,
// já tenant-scoped via ServiceOrderRepository.byId() antes de chegar aqui.
// NÃO adicionar 'ServiceOrderItem' a TENANT_SCOPED_MODELS. `quantity` é
// Decimal (não Int) pra aceitar quantidade fracionária (ex: 1.5 litro de
// óleo). `unitPriceCents` em centavos, nunca ponto flutuante. Valor total
// da OS nunca é armazenado — sempre somado a partir dos itens não
// removidos (ver plano itens-e-preco-da-os.md).
model ServiceOrderItem {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  serviceOrderId String    @map("service_order_id") @db.Uuid
  type           String
  description    String
  careServiceKey String?  @map("care_service_key")
  quantity       Decimal   @db.Decimal(10, 2)
  unitPriceCents Int       @map("unit_price_cents")
  catalogItemId  String?   @map("catalog_item_id") @db.Uuid
  costCents      Int?      @map("cost_cents")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  @@index([serviceOrderId])
  @@map("service_order_items")
}

// Catálogo de peças, produtos e serviços (mão de obra) da oficina. Os itens da
// OS copiam nome e preço no momento do lançamento: editar o catálogo não altera
// orçamentos já feitos.
model CatalogItem {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  type           String
  name           String
  category       String?
  unitPriceCents Int       @default(0) @map("unit_price_cents")
  costCents      Int?      @map("cost_cents")
  code           String?
  brand          String?
  unit           String    @default("un")
  supplierId     String?   @map("supplier_id") @db.Uuid
  standardMinutes Int?     @map("standard_minutes")
  careServiceKey String?   @map("care_service_key")
  trackStock     Boolean   @default(false) @map("track_stock")
  stockQuantity  Decimal   @default(0) @map("stock_quantity") @db.Decimal(10, 2)
  minStock       Decimal?  @map("min_stock") @db.Decimal(10, 2)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, type, name])
  @@map("catalog_items")
}

// Every change of a catalog item's stock balance. SALE is written once per order and item.
model StockMovement {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  catalogItemId  String   @map("catalog_item_id") @db.Uuid
  serviceOrderId String?  @map("service_order_id") @db.Uuid
  kind           String
  quantity       Decimal  @db.Decimal(10, 2)
  balanceAfter   Decimal  @map("balance_after") @db.Decimal(10, 2)
  note           String?
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, catalogItemId, createdAt])
  @@map("stock_movements")
}

// A named set of catalog items added to an order in one go, at today's prices.
model CatalogPackage {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@map("catalog_packages")
}

model CatalogPackageItem {
  id            String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  packageId     String  @map("package_id") @db.Uuid
  catalogItemId String  @map("catalog_item_id") @db.Uuid
  quantity      Decimal @default(1) @db.Decimal(10, 2)

  @@index([packageId])
  @@map("catalog_package_items")
}

// Feature: Integração FIPE. Catálogo global de marcas/modelos sincronizado
// da API pública da FIPE — NÃO é dado de tenant (compartilhado por toda
// oficina), por isso sem tenantId e NUNCA adicionado a TENANT_SCOPED_MODELS
// (diferente do caso de ServiceOrderStatusHistory acima, que é excluído por
// não ter a coluna mas ainda ser dado de UM tenant específico — aqui é
// "não é dado de tenant nenhum"). Sem soft delete: sincronização é sempre
// upsert (createMany skipDuplicates), nunca remove — ver spec.
model FipeBrand {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  category  String
  fipeCode  String    @map("fipe_code")
  name      String
  syncedAt  DateTime  @map("synced_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([category, fipeCode])
  @@map("fipe_brands")
}

model FipeModel {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  brandId   String    @map("brand_id") @db.Uuid
  fipeCode  String    @map("fipe_code")
  name      String
  syncedAt  DateTime  @map("synced_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([brandId, fipeCode])
  @@index([brandId])
  @@map("fipe_models")
}

// Feature: Motor de Manutenção Preventiva. tenantId presente e entra em
// TENANT_SCOPED_MODELS (diferente de FipeBrand/FipeModel — aqui É dado de
// tenant). O job diário (MaintenanceAlertScanProcessor) sempre acessa via
// `prisma.unscoped` com tenantId explícito, porque roda fora do
// AsyncLocalStorage de uma requisição (mesmo padrão de AuditLogRepository);
// só o Controller/Manager (list, resolve) e o hook de auto-resolve em
// ServiceOrderManager.transition usam `prisma.client`/`tx` escopado. Sem
// deleted_at: alertas nunca são apagados, só resolvidos (campo `status`) —
// ver spec motor-manutencao-preventiva.md.
model MaintenanceAlert {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  vehicleId     String    @map("vehicle_id") @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  referenceDate DateTime  @map("reference_date") @db.Timestamptz
  status        String    @default("OPEN")
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz
  resolvedBy    String?   @map("resolved_by") @db.Uuid
  snoozedUntil  DateTime? @map("snoozed_until") @db.Timestamptz
  dismissReason String?   @map("dismiss_reason")
  dismissNote   String?   @map("dismiss_note")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Chave de idempotência do job: no máximo um alerta por ciclo de
  // manutenção de cada veículo (Edge Cases 2/3 da spec).
  @@unique([vehicleId, referenceDate])
  @@index([tenantId, status])
  @@map("maintenance_alerts")
}

// One attempt to reach the customer about an alert.
model MaintenanceAlertContact {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  alertId   String   @map("alert_id") @db.Uuid
  outcome   String
  note      String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, alertId, createdAt])
  @@map("maintenance_alert_contacts")
}

model ServiceOrderPhoto {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  serviceOrderId String    @map("service_order_id") @db.Uuid
  category       String
  // Só preenchido pra category ENTRY/EXIT: um dos 6 ângulos padrão
  // (FRONT/REAR/LEFT_SIDE/RIGHT_SIDE/SPARE_TIRE/DASHBOARD) — mesmo conjunto
  // nas duas pontas pra permitir comparação direta antes/depois.
  angle              String?
  // Só preenchido pra category ISSUE/RESOLVED: a peça/serviço (ServiceOrderItem)
  // que esta foto documenta. Sem @relation (padrão do schema — ver
  // ServiceOrderItem, sem tenantId próprio, validado na camada de app).
  serviceOrderItemId String?   @map("service_order_item_id") @db.Uuid
  caption        String?
  storageKey     String    @map("storage_key")
  originalName   String    @map("original_name")
  mimeType       String    @map("mime_type")
  sizeBytes      Int       @map("size_bytes")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, serviceOrderId, category])
  @@index([serviceOrderItemId])
  @@map("service_order_photos")
}

